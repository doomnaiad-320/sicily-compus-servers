<view class="order-detail">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-container">
    <t-loading theme="circular" size="48rpx" text="加载中..." />
  </view>

  <!-- 订单内容 -->
  <view wx:elif="{{order}}" class="order-content">
    <!-- 顶部状态卡片 -->
    <view class="status-card" style="background: {{statusBgColor}};">
      <view class="status-info">
        <text class="status-text">{{statusText}}</text>
        <text class="order-no">#{{order.orderNo || order.id}}</text>
      </view>
      <view class="amount-info">
        <text class="amount-label">服务费用</text>
        <text class="amount-value">¥{{order.amount}}</text>
      </view>
    </view>

    <!-- 服务信息卡片 -->
    <view class="info-card">
      <view class="card-title">服务信息</view>
      <view class="info-row">
        <text class="info-label">服务类型</text>
        <text class="info-value">{{order.type}}</text>
      </view>
      <view class="info-row" wx:if="{{order.title}}">
        <text class="info-label">订单标题</text>
        <text class="info-value">{{order.title}}</text>
      </view>
      <view class="info-row desc-row">
        <text class="info-label">需求描述</text>
        <text class="info-value desc-text">{{order.description}}</text>
      </view>
    </view>

    <!-- 时间地点卡片 -->
    <view class="info-card">
      <view class="card-title">时间地点</view>
      <view class="info-row">
        <text class="info-icon">📍</text>
        <text class="info-value flex-1">{{order.address}}</text>
      </view>
      <view class="info-row" wx:if="{{order.expectedTime}}">
        <text class="info-icon">⏰</text>
        <text class="info-value flex-1">{{order.expectedTime}}</text>
      </view>
    </view>

    <!-- 联系信息卡片 -->
    <view class="info-card" wx:if="{{contactDisplayName || contactDisplayPhone}}">
      <view class="card-title">{{contactCardTitle}}</view>
      <view class="info-row" wx:if="{{contactDisplayName}}">
        <text class="info-icon">👤</text>
        <text class="info-value flex-1">{{contactDisplayName}}</text>
        <t-button
          wx:if="{{chatEntry}}"
          size="extra-small"
          theme="primary"
          variant="outline"
          class="contact-action"
          bindtap="onChatTap"
        >
          {{chatEntry.text}}
        </t-button>
      </view>
      <view class="info-row" wx:if="{{contactDisplayPhone}}">
        <text class="info-icon">📞</text>
        <text class="info-value flex-1">{{contactDisplayPhone}}</text>
        <t-button size="extra-small" theme="primary" variant="outline" data-phone="{{contactDisplayPhone}}" bindtap="callPhone">拨打</t-button>
      </view>
    </view>

    <!-- 图片展示 -->
    <view class="info-card" wx:if="{{order.images && order.images.length > 0}}">
      <view class="card-title">相关图片</view>
      <view class="image-list">
        <image
          wx:for="{{order.images}}"
          wx:key="index"
          src="{{item}}"
          mode="aspectFill"
          class="order-image"
          data-url="{{item}}"
          bindtap="previewImage"
        />
      </view>
    </view>

    <!-- 交付内容录入（仅接单兼职者且服务中） -->
    <view class="info-card" wx:if="{{canDeliver}}">
      <view class="card-title">交付内容</view>
      <view class="input-group">
        <view class="input-row">
          <text class="input-label">备注</text>
          <text class="input-tip">对用户可见，描述服务情况</text>
        </view>
        <textarea
          class="delivery-textarea"
          value="{{deliveryNoteInput}}"
          placeholder="填写服务备注"
          placeholder-class="placeholder"
          maxlength="200"
          auto-height
          bindinput="onNoteInput"
        />
      </view>
      <view class="input-group">
        <view class="input-row">
          <text class="input-label">交付图片</text>
          <text class="input-tip">最多6张</text>
        </view>
        <view class="upload-list">
          <view
            wx:for="{{deliveryImages}}"
            wx:key="index"
            class="upload-thumb"
            data-index="{{index}}"
          >
            <image
              src="{{item}}"
              mode="aspectFill"
              data-url="{{item}}"
              bindtap="previewDeliveryImage"
            />
            <view class="upload-remove" data-index="{{index}}" catchtap="removeDeliveryImage">×</view>
          </view>
          <view
            wx:if="{{deliveryImages.length < 6}}"
            class="upload-add"
            bindtap="chooseDeliveryImages"
          >
            <text>＋</text>
          </view>
        </view>
      </view>
      <t-button
        block
        theme="primary"
        size="large"
        loading="{{submitting || uploading}}"
        bindtap="submitDelivery"
      >
        交付任务
      </t-button>
    </view>

    <!-- 交付内容展示 -->
    <view
      class="info-card"
      wx:if="{{showDeliveryContent}}"
    >
      <view class="card-title">交付内容</view>
      <view class="info-row desc-row" wx:if="{{order.deliveryNote}}">
        <text class="info-label">备注</text>
        <text class="info-value desc-text">{{order.deliveryNote}}</text>
      </view>
      <view class="image-list" wx:if="{{order.deliveryImages && order.deliveryImages.length > 0}}">
        <image
          wx:for="{{order.deliveryImages}}"
          wx:key="index"
          src="{{item}}"
          mode="aspectFill"
          class="order-image"
          data-url="{{item}}"
          bindtap="previewDeliveryImage"
        />
      </view>
      <view class="deliver-meta" wx:if="{{order.deliveredAt}}">
        <text>交付时间：{{order.deliveredAt}}</text>
      </view>
    </view>

    <view class="info-card" wx:if="{{order.review}}">
      <view class="card-title">服务评价</view>
      <view class="review-head">
        <text class="review-rating">{{order.review.rating}} / 5 分</text>
        <text class="review-time" wx:if="{{order.review.createdAtText}}">
          {{order.review.createdAtText}}
        </text>
      </view>
      <view class="review-content">
        {{order.review.content || "用户未填写文字评价"}}
      </view>

      <view class="reply-block" wx:if="{{order.review.replyContent}}">
        <view class="reply-title">兼职者回复</view>
        <view class="reply-content">{{order.review.replyContent}}</view>
        <view class="reply-time" wx:if="{{order.review.workerRepliedAtText}}">
          {{order.review.workerRepliedAtText}}
        </view>
      </view>
      <view class="reply-editor" wx:elif="{{canReplyReview}}">
        <view class="reply-title">回复评价</view>
        <textarea
          class="delivery-textarea"
          value="{{reviewReplyInput}}"
          placeholder="回复用户的评价"
          placeholder-class="placeholder"
          maxlength="200"
          auto-height
          bindinput="onReviewReplyInput"
        />
        <t-button
          block
          theme="primary"
          size="large"
          loading="{{replyingReview}}"
          bindtap="submitReviewReply"
        >
          提交回复
        </t-button>
      </view>
      <view class="reply-pending" wx:else>等待兼职者回复</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-container">
    <t-empty icon="info-circle-filled" description="订单不存在" />
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar" wx:if="{{actions.length > 0}}">
    <t-button
      wx:for="{{actions}}"
      wx:key="key"
      theme="{{item.theme}}"
      size="large"
      class="action-btn"
      data-key="{{item.key}}"
      loading="{{submitting}}"
      bindtap="onActionTap"
    >
      {{item.text}}
    </t-button>
  </view>
</view>
