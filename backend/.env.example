# Copy this file to .env.local before starting the backend.

# Prisma / SQLite
# This points at the sqlite database that already exists in the repo:
# backend/prisma/prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"

# JWT
JWT_SECRET="replace-this-with-a-long-random-string"

# WeChat Mini Program
# In local development, this should match miniprogem/project.config.json -> appid
WECHAT_APPID="wx8e54bced7dbc10bd"
WECHAT_SECRET="replace-with-your-wechat-mini-program-secret"

# Admin login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
